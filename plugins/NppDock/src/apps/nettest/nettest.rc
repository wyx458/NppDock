// ============================================================================
// nettest.rc —— 版本信息资源
// ----------------------------------------------------------------------------
// 【FileDescription 就是 dock 里的标签页标题】
//   NppDock 容器扫描到 NppDockApp_*.exe 之后，读 exe 的 VERSIONINFO 里的
//   FileDescription 当标题。元数据跟着二进制走，复制/改名都不会脱节；
//   同时也让资源管理器里鼠标悬停能显示像样的描述。
//
// 注意 1：用 `1 VERSIONINFO`（而不是 VS_VERSION_INFO），省掉 <winver.h> 依赖。
// 注意 2：`#pragma code_page(65001)` 让 rc.exe 按 UTF-8 读本文件，
//         否则中文 FileDescription 会变乱码（文件存为 UTF-8 无 BOM）。
// 注意 3：ProduchName/OriginalFilename 里的 "NppDockApp_NET" 必须和
//         build.py 里 APPS 的 name 对得上（面板记录应用页用的是文件名）。
// ============================================================================

#pragma code_page(65001)

1 VERSIONINFO
 FILEVERSION    1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文，04b0 = Unicode(1200)
        BLOCK "080404b0"
        BEGIN
            // ★ dock 标签页标题（也是独立打开时的窗口标题）
            VALUE "FileDescription",  "网络测试"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "nettest"
            VALUE "OriginalFilename", "NppDockApp_NET.exe"
            VALUE "ProductName",      "NppDock"
            VALUE "ProductVersion",   "1.2.0.0"
            VALUE "LegalCopyright",   "自用工具"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
